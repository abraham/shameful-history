{
  "name": "shameful-history",
  "version": "1.0.0",
  "private": true,
  "description": "A timeline of events where the US government did something shameful or, through inaction, allowed something shameful to happen.",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "format": "prettier . --write",
    "lint-md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint-prettier": "prettier . --check",
    "lint": "npm run lint-md && npm run lint-prettier",
    "deploy": "firebase deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/shameful-history.git"
  },
  "author": "Abraham Williams",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abraham/shameful-history/issues"
  },
  "homepage": "https://shamefulhistory.com",
  "type": "module",
  "engines": {
    "node": "26"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.0.0",
    "eleventy-plugin-feathericons": "^2.0.0",
    "firebase-tools": "^15.36.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "3.9.10"
  }
}
